{
  "name": "entrenamiento",
  "version": "1.0.0",
  "description": "Proyecto de node con typescript",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon ./src/main.ts",
    "build": "tsc",
    "start": " node dist/main.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate src/migrations/%npm_config_name% -d src/config/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/config/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/data-source.ts",
    "migration:create": "npm run typeorm -- migration:create src/migrations/%npm_config_name%",
    "migration:show": "npm run typeorm -- migration:show -d src/config/data-source.ts",
    "migration:drop": "npm run typeorm -- schema:drop -d src/config/data-source.ts"
  },
  "keywords": [],
  "author": "Victor Mauricio Vega",
  "license": "ISC",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2"
  }
}
